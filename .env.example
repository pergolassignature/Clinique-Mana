# Clinique MANA - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file with real credentials

# Supabase Configuration
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/<your-ref>/settings/api

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public Key (safe for frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# Local Development (supabase start)
# ============================================
# VITE_SUPABASE_URL=http://127.0.0.1:55321
# VITE_SUPABASE_ANON_KEY=<from supabase start output>

# ============================================
# SECURITY WARNING
# ============================================
# NEVER use service_role key in frontend code!
# The anon key is designed to be public and works with RLS.

# Optional: Sentry error reporting (leave empty locally)
VITE_SENTRY_DSN=

# The clinic's Documenso, the only other site the app may frame (the image consent signed in
# the app, P4-488): https://sign.cliniquemana.com on Vercel; the local fake below.
# VITE_DOCUMENSO_URL=http://127.0.0.1:55390
VITE_DOCUMENSO_URL=

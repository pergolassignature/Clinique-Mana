{
  "name": "clinique-mana",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && npm run lint:tokens",
    "lint:tokens": "bash scripts/check-design-tokens.sh",
    "lint:supabase": "bash scripts/check-component-supabase.sh",
    "lint:migrations": "node scripts/check-migration-timestamps.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:functions": "deno test --frozen --allow-env --allow-read=supabase/functions --config supabase/functions/deno.json supabase/functions/",
    "check:functions": "deno check --frozen --config supabase/functions/deno.json supabase/functions/",
    "lint:functions": "deno lint --config supabase/functions/deno.json supabase/functions/",
    "build:pdf-fonts": "deno run --no-config --allow-read=node_modules/@fontsource/inter --allow-write=supabase/functions/_shared/pdf/fonts.ts,supabase/functions/_shared/pdf/OFL-Inter.txt scripts/build-pdf-fonts.ts",
    "build:pdfmake": "deno run --no-config --allow-run=deno --allow-read --allow-write=supabase/functions/_shared/pdf/vendor/pdfmake.js,supabase/functions/_shared/pdf/vendor/pdfmake.js.sha256 scripts/build-pdfmake.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/core/supabase/database.types.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "fake:documenso": "node scripts/fake-documenso.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@sentry/react": "^11.5.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.64.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@fontsource/inter": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.0.9",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}

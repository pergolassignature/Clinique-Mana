# Local edge-function environment. Copy to supabase/functions/.env (gitignored).
# Every value here is a LOCAL FAKE. Real values are function secrets on staging (plan « Mise en service »).
# A local http APP_URL also lets the signing functions call the Documenso fake at
# http://host.docker.internal and skip the public-address check (P3-34). Never local on staging.
# APP_URL builds the emails' links: an https origin, or exactly http://localhost:5173 locally
# (_shared/links.ts appOrigin); any other port makes the invitation functions answer 500.
APP_URL=http://localhost:5173
# The browser origins allowed to call the functions: the dev server, and Playwright's own server
# (e2e/fixtures/origin.ts, 5190), whose onboarding spec invites and uploads through them.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5190
# Where clientIp() reads the caller's IP for rate limits: `xff-rightmost` (default: the
# rightmost x-forwarded-for entry, appended by the gateway) or `cf-connecting-ip` (only
# behind a Cloudflare front that sets it).
# CLIENT_IP_SOURCE=xff-rightmost
# storage-sign: the API origin a browser uses. Locally the functions reach the API as
# http://kong:8000, so signed read URLs are rewritten to this origin. Leave unset on hosted
# projects (SUPABASE_URL is already public there).
PUBLIC_API_URL=http://127.0.0.1:55321
# storage-sign: `off` signs the original images instead of their small copies (image variants,
# ADR 0009). Only for a stack without image transformations (imgproxy not running); unset on
# staging, where it is the kill switch if transformations ever fail.
# STORAGE_IMAGE_VARIANTS=off
# professionals-consent-sign (P4-488): the Documenso address a browser uses (the embed's host, the
# signing link). Locally the functions reach the fake as host.docker.internal; honoured only with a
# local APP_URL. Leave unset on hosted projects (signing_settings.base_url is already public).
DOCUMENSO_PUBLIC_URL=http://127.0.0.1:55390
EMAIL_TRANSPORT=mailpit
# Mailpit seen from the edge-runtime container (verify the name with `docker ps`):
MAILPIT_URL=http://supabase_inbucket_clinique-mana:8025
INTERNAL_FUNCTION_SECRET=local-dev-internal-function-secret
SENTRY_DSN=
# places (Google Places address suggestions, P4-220): the local fake (`npm run fake:places`,
# port 55391) and its key. GOOGLE_PLACES_BASE_URL is honoured only while APP_URL is local; on
# staging only the real GOOGLE_PLACES_API_KEY is set (status doc, « Mise en service »). Comment
# both lines out to see the field without suggestions (plain typing, nothing else changes).
GOOGLE_PLACES_API_KEY=local-dev-google-places-key
GOOGLE_PLACES_BASE_URL=http://host.docker.internal:55391
# Gmail (Communications, CM1): the local fake Google (`npm run fake:gmail`, port 55392): the API,
# the token endpoint, the consent page and the keys of the push tokens as the functions reach them,
# and the consent page as the browser reaches it. Honoured only while APP_URL is local; on staging none is set (Google's own
# origins). The fake's OAuth client and the push's service account are the seed org's (seed.sql).
GMAIL_API_BASE_URL=http://host.docker.internal:55392
GOOGLE_OAUTH_BASE_URL=http://host.docker.internal:55392
GOOGLE_ACCOUNTS_BASE_URL=http://host.docker.internal:55392
GOOGLE_CERTS_BASE_URL=http://host.docker.internal:55392
GOOGLE_ACCOUNTS_PUBLIC_URL=http://127.0.0.1:55392
# QuickBooks (Facturation, FQ): the local fake Intuit (`npm run fake:qbo`, port 55394): the consent
# page, the token and revocation endpoints and the API as the functions reach them, and the consent
# page as the browser reaches it. Honoured only while APP_URL is local; on staging none is set
# (Intuit's own origins). The fake's application is the seed org's (seed.sql).
QBO_APPCENTER_BASE_URL=http://host.docker.internal:55394
QBO_APPCENTER_PUBLIC_URL=http://127.0.0.1:55394
QBO_OAUTH_BASE_URL=http://host.docker.internal:55394
QBO_REVOKE_BASE_URL=http://host.docker.internal:55394
QBO_API_BASE_URL=http://host.docker.internal:55394
# Stripe (Facturation, FS): the local fake Stripe (`npm run fake:stripe`, port 55397): the API as
# the functions reach it. Honoured only while APP_URL is local; on hosted projects it is never set
# (api.stripe.com). The fake's keys are the seed org's (seed.sql).
STRIPE_API_BASE_URL=http://host.docker.internal:55397
# sms-send, sms-dispatch, sms-webhook (textos, batch SM): the local fake PBX (`npm run fake:yeastar`,
# port 55393). YEASTAR_BASE_URL replaces the clinic's « Adresse de la centrale » only while APP_URL
# is local; on hosted projects it is never set (the address, the credentials and the number live in
# Paramètres → Textos and Vault). The seed holds the fake's credentials and webhook secret.
YEASTAR_BASE_URL=http://host.docker.internal:55393
# Zoom (Rendez-vous, RZ): the local fake Zoom (`npm run fake:zoom`, port 55394): the token endpoint
# and the API as the functions reach them, and the consent page as the browser reaches it. Honoured
# only while APP_URL is local; on hosted projects none is set (Zoom's own origins). The fake's Zoom
# app and webhook secret are the seed org's (seed.sql).
ZOOM_OAUTH_BASE_URL=http://host.docker.internal:55394
ZOOM_API_BASE_URL=http://host.docker.internal:55394
ZOOM_OAUTH_PUBLIC_URL=http://127.0.0.1:55394
